  "layout": "sidebar",
  "modules": [
    { "id": "veyviz-sources", "version": "0.1.0" },
    { "id": "veyviz-analysis", "version": "0.1.0" },
    { "id": "veyviz-rfdetr", "version": "0.1.0" }
