  "bindings": [
    { "contract": "veyviz.sources.read.v1", "instanceId": "local-veyviz-sources", "implementation": "veyviz-sources", "scope": "application", "consumer": "veyviz-analysis", "mode": "local" },
    { "contract": "veyviz.recorded-analysis.run.v1", "instanceId": "local-veyviz-rfdetr", "implementation": "veyviz-rfdetr", "scope": "application", "consumer": "veyviz-analysis", "mode": "local" }
  ],
  "wiring": "veyviz"
}
