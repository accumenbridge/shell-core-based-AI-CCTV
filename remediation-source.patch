@@ -0,0 +1,12 @@
+import type { WorkspaceContext } from '@quadbridge/contracts';
+import {el} from '@quadbridge/web-shell/dom';
+/** A second screen deliberately loaded as a literal lazy chunk, not a monolithic ui.ts. */
+export async function renderOverview(ctx: WorkspaceContext) {
+    const data=await ctx.api.get('/api/requests') as {items:{id:string;title:string;state:string}[]};
+    if(ctx.signal.aborted)return;
+    ctx.root.replaceChildren(el('h1','','Request overview'),el('p','muted','This view uses the same Service Desk owner and current tenant scope.'));
+    const list=el('section','request-overview');
+    for(const row of data.items)list.append(el('p','',`${row.title} — ${row.state}`));
+    if(!data.items.length)list.append(el('p','muted','No requests in this tenant.'));
+    ctx.root.append(list);
+}
