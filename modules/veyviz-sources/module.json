{
  "id": "veyviz-sources",
  "version": "0.1.0",
  "abi": "quadbridge.module.v1",
  "dependencies": [],
  "provides": [
    "veyviz.sources.read.v1",
    "veyviz.sources.query.v1",
    "veyviz.product-authority.v1"
  ],
  "requires": [],
  "permissions": [
    "veyviz.sources.read",
    "veyviz.sources.write"
  ],
  "operations": [
    {
      "id": "veyviz-sources.sources.list",
      "version": 1,
      "title": "List video sources",
      "description": "List authorized source registrations for the current tenant.",
      "permission": "veyviz.sources.read",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "fixtureId": {
                  "type": "string",
                  "enum": [
                    "mivia-vid0062"
                  ]
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "created": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "name",
                "fixtureId",
                "version",
                "created"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "veyviz-sources.sources.register",
      "version": 1,
      "title": "Register a recorded fixture",
      "description": "Register the single reviewed local recording fixture by opaque identifier.",
      "permission": "veyviz.sources.write",
      "kind": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fixtureId": {
            "type": "string",
            "enum": [
              "mivia-vid0062"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "fixtureId",
          "name"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "fixtureId": {
            "type": "string",
            "enum": [
              "mivia-vid0062"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "fixtureId",
          "version",
          "created"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "veyviz-sources.sources.query",
      "version": 1,
      "title": "Search registered recordings",
      "description": "Search a bounded page of owner-authorized registrations by literal source name or ID.",
      "permission": "veyviz.sources.read",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 200
          },
          "renamedOnly": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "fixtureId": {
                  "type": "string",
                  "enum": [
                    "mivia-vid0062"
                  ]
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "created": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "name",
                "fixtureId",
                "version",
                "created"
              ],
              "additionalProperties": false
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "nextCursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "coverage": {
                "type": "string",
                "enum": [
                  "filtered-owner-query"
                ]
              }
            },
            "required": [
              "limit",
              "coverage"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "items",
          "page"
        ],
        "additionalProperties": false
      }
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/api/sources",
      "permission": "veyviz.sources.read",
      "kind": "read"
    },
    {
      "method": "GET",
      "path": "/api/sources/query",
      "permission": "veyviz.sources.read",
      "kind": "read"
    },
    {
      "method": "POST",
      "path": "/api/sources",
      "permission": "veyviz.sources.write",
      "kind": "write"
    },
    {
      "method": "POST",
      "path": "/api/sources/rename",
      "permission": "veyviz.sources.write",
      "kind": "write"
    }
  ],
  "workspaces": [
    {
      "id": "veyviz.sources",
      "label": "Recordings",
      "path": "/recordings",
      "permission": "veyviz.sources.read",
      "export": "workspace"
    }
  ],
  "uiContributions": [],
  "schema": {
    "current": 1,
    "readMin": 1,
    "readMax": 1
  },
  "background": false,
  "browserAssets": [
    "styles.css"
  ],
  "studio": {
    "label": "Veyviz sources",
    "summary": "Tenant-owned registrations for reviewed local recordings.",
    "category": "video",
    "layers": [
      "ui",
      "backend",
      "data"
    ],
    "ui": {
      "routes": [
        {
          "path": "/recordings",
          "workspace": "veyviz.sources",
          "label": "Recordings",
          "nav": "Recordings"
        }
      ],
      "extensionPoints": []
    },
    "backend": {
      "services": [
        {
          "id": "source-reader",
          "contract": "veyviz.sources.read.v1",
          "visibility": "product"
        },
        {
          "id": "source-query",
          "contract": "veyviz.sources.query.v1",
          "visibility": "product"
        }
      ],
      "jobs": []
    },
    "ai": {
      "pipelines": [],
      "models": []
    },
    "data": {
      "stores": [
        {
          "id": "veyviz-sources",
          "kind": "relational",
          "ownership": "module"
        }
      ],
      "schemas": [
        {
          "id": "veyviz-sources",
          "version": 1
        }
      ]
    },
    "deployment": {
      "processes": [
        {
          "id": "veyviz-product-api",
          "kind": "http"
        }
      ]
    }
  }
}