{
  "id": "knowledge",
  "version": "0.2.4",
  "abi": "quadbridge.module.v1",
  "dependencies": [],
  "provides": [
    "knowledge.document.read.v1",
    "knowledge.document.retrieve.v1"
  ],
  "requires": [],
  "permissions": [
    "knowledge.read",
    "knowledge.write"
  ],
  "operations": [
    {
      "id": "knowledge.documents.search",
      "version": 1,
      "title": "Search documents",
      "description": "Search the current tenant’s indexed Knowledge documents.",
      "permission": "knowledge.read",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": [
                "id",
                "title",
                "version",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "coverage": {
            "type": "string",
            "enum": [
              "INDEXED_DOCUMENTS_ONLY"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "items",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "knowledge.documents.get",
      "version": 1,
      "title": "Get a document",
      "description": "Read a bounded tenant-owned Knowledge document projection.",
      "permission": "knowledge.read",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "documentId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "READY"
            ]
          },
          "excerpt": {
            "type": "string",
            "maxLength": 4096
          },
          "truncated": {
            "type": "boolean"
          },
          "bodyDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "title",
          "version",
          "state",
          "excerpt",
          "truncated",
          "bodyDigest"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "knowledge.documents.create",
      "version": 1,
      "title": "Create a document",
      "description": "Create a tenant-owned Knowledge document and enqueue its index job.",
      "permission": "knowledge.write",
      "kind": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64000
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING"
            ]
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "title",
          "version",
          "state",
          "jobId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/api/documents",
      "permission": "knowledge.read",
      "kind": "read"
    },
    {
      "method": "GET",
      "path": "/api/documents/search",
      "permission": "knowledge.read",
      "kind": "read"
    },
    {
      "method": "POST",
      "path": "/api/documents/answer",
      "permission": "knowledge.read",
      "kind": "read"
    },
    {
      "method": "POST",
      "path": "/api/documents",
      "permission": "knowledge.write",
      "kind": "write"
    },
    {
      "method": "POST",
      "path": "/api/documents/cancel-index",
      "permission": "knowledge.write",
      "kind": "write"
    }
  ],
  "workspaces": [
    {
      "id": "knowledge.library",
      "label": "Knowledge library",
      "path": "/library",
      "permission": "knowledge.read",
      "export": "workspace"
    }
  ],
  "uiContributions": [
    {
      "id": "knowledge.referenceSearch",
      "permission": "knowledge.read",
      "export": "referenceSearchPanel",
      "label": "Reference search"
    }
  ],
  "schema": {
    "current": 1,
    "readMin": 1,
    "readMax": 1
  },
  "background": true,
  "studio": {
    "label": "Knowledge",
    "summary": "Document library with local extractive answers grounded in indexed sources.",
    "category": "knowledge",
    "layers": [
      "ui",
      "backend",
      "worker",
      "ai",
      "data"
    ],
    "ui": {
      "routes": [
        {
          "path": "/library",
          "workspace": "knowledge.library",
          "label": "Knowledge library",
          "nav": "Knowledge"
        }
      ],
      "extensionPoints": [
        "knowledge.document.actions"
      ]
    },
    "backend": {
      "services": [
        {
          "id": "document-reader",
          "contract": "knowledge.document.read.v1",
          "visibility": "product"
        },
        {
          "id": "document-retriever",
          "contract": "knowledge.document.retrieve.v1",
          "visibility": "product"
        }
      ],
      "jobs": [
        {
          "kind": "knowledge.index",
          "permission": "knowledge.write"
        }
      ]
    },
    "ai": {
      "pipelines": [
        {
          "id": "knowledge-rag",
          "label": "Knowledge retrieval pipeline",
          "input": "query",
          "output": "grounded-context"
        },
        {
          "id": "knowledge-extractive-answer",
          "label": "Local extractive answer",
          "input": "question",
          "output": "cited-source-excerpts"
        }
      ],
      "models": [
        {
          "capability": "text.embedding",
          "modality": "embedding",
          "placement": "either",
          "accelerator": "either"
        },
        {
          "capability": "text.generate",
          "modality": "text",
          "placement": "either",
          "accelerator": "either"
        }
      ]
    },
    "data": {
      "stores": [
        {
          "id": "knowledge-records",
          "kind": "relational",
          "ownership": "module"
        },
        {
          "id": "knowledge-vectors",
          "kind": "vector",
          "ownership": "module"
        }
      ],
      "schemas": [
        {
          "id": "knowledge",
          "version": 1
        }
      ]
    },
    "deployment": {
      "processes": [
        {
          "id": "knowledge-api",
          "kind": "http"
        },
        {
          "id": "knowledge-worker",
          "kind": "worker"
        }
      ]
    }
  }
}
