{
  "id": "veyviz-analysis",
  "version": "0.1.0",
  "abi": "quadbridge.module.v1",
  "dependencies": [
    {
      "id": "veyviz-sources",
      "version": "0.1.0"
    }
  ],
  "provides": [],
  "requires": [
    "veyviz.sources.read.v1",
    "veyviz.recorded-analysis.run.v1"
  ],
  "permissions": [
    "veyviz.analysis.read",
    "veyviz.analysis.write"
  ],
  "operations": [
    {
      "id": "veyviz-analysis.analysis.list",
      "version": 1,
      "title": "List analyses",
      "description": "List analysis jobs and accepted-result summaries for the current tenant.",
      "permission": "veyviz.analysis.read",
      "kind": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "jobId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sourceVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "jobState": {
                  "type": "string",
                  "enum": [
                    "QUEUED",
                    "RUNNING",
                    "CANCEL_REQUESTED",
                    "CANCELLED",
                    "SUCCEEDED",
                    "FAILED"
                  ]
                },
                "reviewState": {
                  "type": "string",
                  "enum": [
                    "OPEN",
                    "REVIEWED",
                    "DISMISSED"
                  ]
                },
                "created": {
                  "type": "integer",
                  "minimum": 0
                },
                "sampleCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "detectionCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "coverage": {
                  "type": "string",
                  "enum": [
                    "UNCOMMISSIONED_RECORDING",
                    "UNKNOWN"
                  ]
                },
                "occupancy": {
                  "type": "string",
                  "enum": [
                    "UNKNOWN"
                  ]
                }
              },
              "required": [
                "id",
                "jobId",
                "sourceId",
                "sourceVersion",
                "jobState",
                "reviewState",
                "created",
                "sampleCount",
                "detectionCount",
                "coverage",
                "occupancy"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "veyviz-analysis.analysis.submit",
      "version": 1,
      "title": "Submit recorded analysis",
      "description": "Queue bounded local RF-DETR analysis for an authorized registered source.",
      "permission": "veyviz.analysis.write",
      "kind": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "sampleStride": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "sourceId",
          "frameCount",
          "sampleStride"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED"
            ]
          }
        },
        "required": [
          "id",
          "jobId",
          "state"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "veyviz-analysis.analysis.cancel",
      "version": 1,
      "title": "Cancel analysis",
      "description": "Request cancellation and report the durable job state for an owned analysis.",
      "permission": "veyviz.analysis.write",
      "kind": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "analysisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "analysisId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "jobState": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "CANCELLED",
              "SUCCEEDED",
              "FAILED"
            ]
          }
        },
        "required": [
          "id",
          "jobState"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "veyviz-analysis.analysis.review",
      "version": 1,
      "title": "Record result review",
      "description": "Record a human review state for an already accepted analysis result.",
      "permission": "veyviz.analysis.write",
      "kind": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "analysisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "decision": {
            "type": "string",
            "enum": [
              "REVIEWED",
              "DISMISSED"
            ]
          }
        },
        "required": [
          "analysisId",
          "decision"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "decision": {
            "type": "string",
            "enum": [
              "REVIEWED",
              "DISMISSED"
            ]
          },
          "reviewedAt": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "decision",
          "reviewedAt"
        ],
        "additionalProperties": false
      }
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/api/analysis/sources",
      "permission": "veyviz.analysis.read",
      "kind": "read"
    },
    {
      "method": "GET",
      "path": "/api/analysis/readiness",
      "permission": "veyviz.analysis.read",
      "kind": "read"
    },
    {
      "method": "GET",
      "path": "/api/analysis",
      "permission": "veyviz.analysis.read",
      "kind": "read"
    },
    {
      "method": "POST",
      "path": "/api/analysis",
      "permission": "veyviz.analysis.write",
      "kind": "write"
    },
    {
      "method": "GET",
      "path": "/api/analysis/result",
      "permission": "veyviz.analysis.read",
      "kind": "read"
    },
    {
      "method": "POST",
      "path": "/api/analysis/cancel",
      "permission": "veyviz.analysis.write",
      "kind": "write"
    },
    {
      "method": "POST",
      "path": "/api/analysis/review",
      "permission": "veyviz.analysis.write",
      "kind": "write"
    }
  ],
  "workspaces": [
    {
      "id": "veyviz.command",
      "label": "Command Center",
      "path": "/command-center",
      "permission": "veyviz.analysis.read",
      "export": "commandCenter"
    },
    {
      "id": "veyviz.analysis",
      "label": "Investigate",
      "path": "/analysis",
      "permission": "veyviz.analysis.read",
      "export": "workspace"
    }
  ],
  "uiContributions": [],
  "schema": {
    "current": 1,
    "readMin": 1,
    "readMax": 1
  },
  "background": true,
  "browserAssets": [
    "styles.css"
  ],
  "studio": {
    "label": "Veyviz analysis",
    "summary": "Durable scoped local video-analysis requests and reviewed results.",
    "category": "video",
    "layers": [
      "ui",
      "backend",
      "worker",
      "data"
    ],
    "ui": {
      "routes": [
        {
          "path": "/command-center",
          "workspace": "veyviz.command",
          "label": "Command Center",
          "nav": "Command Center"
        },
        {
          "path": "/analysis",
          "workspace": "veyviz.analysis",
          "label": "Investigate",
          "nav": "Investigate"
        }
      ],
      "extensionPoints": []
    },
    "backend": {
      "services": [],
      "jobs": [
        {
          "kind": "veyviz.analysis.run.v1",
          "permission": "veyviz.analysis.write"
        }
      ]
    },
    "ai": {
      "pipelines": [
        {
          "id": "veyviz.rfdetr.recorded.v1",
          "label": "Bounded recorded video analysis",
          "input": "registered recording",
          "output": "typed detections and provenance"
        }
      ],
      "models": [
        {
          "capability": "vision.detect",
          "modality": "vision",
          "placement": "edge",
          "accelerator": "cpu"
        }
      ]
    },
    "data": {
      "stores": [
        {
          "id": "veyviz-analysis",
          "kind": "relational",
          "ownership": "module"
        }
      ],
      "schemas": [
        {
          "id": "veyviz-analysis",
          "version": 1
        }
      ]
    },
    "deployment": {
      "processes": [
        {
          "id": "veyviz-product-api",
          "kind": "http"
        },
        {
          "id": "veyviz-product-worker",
          "kind": "worker"
        }
      ]
    }
  }
}
